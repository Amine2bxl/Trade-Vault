# TradeVault — variables d'environnement.
# Documentation complète : BACKEND.md §11.
# Tout ce qui n'est PAS préfixé VITE_ est server-only et ne doit jamais
# atteindre le bundle client.

# --- Domaine canonique (client, build-time) ---
# LA seule variable à changer le jour où un domaine personnalisé est branché.
# Sert de base à toutes les redirections d'authentification (Google OAuth,
# confirmation d'e-mail, réinitialisation de mot de passe). Sans trailing slash.
# Repli codé dans src/shared/site.ts si absente. Détail : BACKEND.md §12.
VITE_SITE_URL=https://tradevault.be

# --- Supabase (client + serveur) ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Secret critique : crons et webhooks uniquement (contourne la RLS).
# Jamais utilisé par une server function agissant pour un utilisateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server-only) ---
# The app is provider-agnostic: it uses the first configured provider, or the
# one named by AI_PROVIDER. Multiple keys are supported: if a provider fails
# (quota, outage), the next configured one answers automatically.
# AI_PROVIDER=            # optional: "gemini" | "anthropic" | "openai" | "groq" | "openrouter"
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI-compatible endpoints — one instance per provider, each with its own key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AI memory (server-only) ---
# Coupe-circuit de l'extraction de mémoire par le LLM. Doit valoir exactement
# "1" pour que `extractMemory` fasse un appel modèle ; toute autre valeur laisse
# la fonction inerte.
# AI_MEMORY_EXTRACTION=1

# --- AI access (server-only) ---
# Paid gating switch. Leave empty / "false" during free early access so every
# signed-in user gets full AI access. Set to "true" to require an active Pro
# plan or trial once subscriptions launch.
AI_REQUIRE_PRO=false
# Per-user hourly cap on AI calls (abuse/cost protection, always on). Default 60.
AI_RATE_LIMIT_PER_HOUR=60
# Plafond d'octets d'un contexte IA envoyé par le client (protection coût).
# Défaut 256000 (~250 Ko). Voir `backend/ai-payload.ts`.
# AI_MAX_CONTEXT_BYTES=256000

# --- Voice (server-only) ---
# One hosted coach voice for every platform (deep, calm, charismatic EN).
# Without this key the app silently falls back to the browser voice.
ELEVENLABS_API_KEY=
# Force the browser voice even when a hosted key is set.
# TTS_PROVIDER=local

# --- Billing (server-only) ---
# UNE VARIABLE DE PRIX PAR PALIER ET PAR PÉRIODE. Le nom est dérivé du plan
# (`STRIPE_PRICE_${PLAN.toUpperCase()}`, billing.server.ts) : un palier sans sa
# variable répond « price not configured » en 500 au checkout — l'offre Elite
# était vendable sur la grille de prix sans être achetable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# --- Administration (server-only) ---
# Adresses séparées par des virgules. C'est la SEULE façon d'être administrateur :
# il n'existe pas de colonne `is_admin` que l'application pourrait écrire.
# Ouvre le panneau des accès offerts, le catalogue de codes promo et la page de
# diagnostic /dev/ai. Vide = aucun administrateur (et donc aucun code promo).
ADMIN_EMAILS=

# --- Lifecycle emails (server-only) ---
RESEND_API_KEY=
EMAIL_FROM="TradeVault <hello@tradevault.be>"
PUBLIC_SITE_URL=https://tradevault.be

# --- Crons (server-only) ---
# Shared secret expected as `Authorization: Bearer $CRON_SECRET` on every cron
# endpoint. Without it the cron handlers answer 401 — never leave it empty in
# production.
CRON_SECRET=

# --- Edge function `delete-account` (secrets Supabase, PAS Vercel) ---
# Elle tourne chez Supabase et ne voit donc PAS l'environnement Vercel. Poser
# ces secrets avec `supabase secrets set` :
#   SUPABASE_URL · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY  (fournis)
#   STRIPE_SECRET_KEY   — sans elle, supprimer un compte NE RÉSILIE PAS
#                          l'abonnement et les prélèvements continuent
#   PUBLIC_SITE_URL     — origine autorisée en CORS

# --- Web push (server-only) ---
# The public key is public by nature (it also ships in the client bundle); the
# private key is required for sendWebPush to work at all.
# VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tradevault@outlook.fr

# --- Analytics (client, build-time) ---
# GA4. Absente = aucun script d'analyse n'est injecté du tout.
# VITE_GA4_MEASUREMENT_ID=

# --- Trustpilot TrustBox (public) ---
VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
